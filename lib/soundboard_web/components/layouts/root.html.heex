<!DOCTYPE html>
<html
  lang="en"
  class={[
    "[scrollbar-gutter:stable]",
    assigns[:theme] == "classic" && "dark"
  ]}
  data-theme={assigns[:theme] || "desk"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta
      name="theme-color"
      content={
        case assigns[:theme] do
          "desk" -> "#B9B5A9"
          "retro" -> "#EDEBE1"
          _ -> "#1f2937"
        end
      }
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="apple-mobile-web-app-title" content="SoundBored" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-touch-fullscreen" content="yes" />

    <link rel="apple-touch-icon" href={~p"/images/icon-192.png"} />
    <.live_title suffix="">
      {assigns[:page_title] || "Soundboard"}
    </.live_title>
    <%= if assigns[:theme] in ["desk", "retro"] do %>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <% end %>
    <%= if assigns[:theme] == "desk" do %>
      <link
        href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet"
      />
    <% end %>
    <%= if assigns[:theme] == "retro" do %>
      <link
        href="https://fonts.googleapis.com/css2?family=Anton&family=Familjen+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    <% end %>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class={["antialiased", assigns[:theme] == "classic" && "bg-gray-900"]}>
    {@inner_content}
  </body>
</html>
