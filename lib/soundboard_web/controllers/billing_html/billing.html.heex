<h1 class="text-2xl font-bold mb-4">Billing</h1>

<div class="border rounded p-4 mb-6 max-w-lg">
  <div class="font-semibold mb-1">Current plan: {@plan_label}</div>
  <div class="text-sm opacity-70">Storage used: {@storage_used} / {@storage_cap}</div>

  <%= if @has_customer do %>
    <.form for={%{}} as={:portal} action={~p"/billing/portal"} class="mt-3">
      <button type="submit" class="btn btn-sm">Manage subscription</button>
    </.form>
  <% end %>
</div>

<h2 class="text-lg font-semibold mb-2">Upgrade</h2>

<ul class="space-y-3 max-w-lg">
  <%= for tier <- @tiers do %>
    <li class="border rounded p-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="font-semibold">
            {tier.name} — {Soundboard.Billing.format_bytes(tier.cap_bytes)}
          </div>
          <div class="text-sm opacity-70">
            ${div(tier.monthly_amount_cents, 100)}/month or ${div(tier.yearly_amount_cents, 100)}/year
          </div>
        </div>
      </div>

      <div class="mt-3 flex gap-2">
        <.form for={%{}} as={:checkout} action={~p"/billing/checkout"} class="inline">
          <input type="hidden" name="price_id" value={tier.price_ids.monthly} />
          <button
            type="submit"
            class="btn btn-sm"
            disabled={is_nil(tier.price_ids.monthly)}
          >
            Subscribe monthly
          </button>
        </.form>

        <.form for={%{}} as={:checkout} action={~p"/billing/checkout"} class="inline">
          <input type="hidden" name="price_id" value={tier.price_ids.yearly} />
          <button
            type="submit"
            class="btn btn-sm"
            disabled={is_nil(tier.price_ids.yearly)}
          >
            Subscribe yearly
          </button>
        </.form>
      </div>
    </li>
  <% end %>
</ul>

<p class="mt-6">
  <a href={~p"/guilds"}>Back to soundboards</a>
</p>
