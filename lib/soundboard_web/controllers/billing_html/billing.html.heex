<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-2 text-3xl font-bold text-gray-800 dark:text-gray-100">Billing</h1>

  <div class="mb-8 rounded-lg bg-white p-5 shadow dark:bg-gray-800">
    <div class="flex items-center justify-between gap-3">
      <div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Current plan</div>
        <div class="text-xl font-semibold text-gray-800 dark:text-gray-100">{@plan_label}</div>
      </div>
      <%= if @has_customer do %>
        <.form for={%{}} as={:portal} action={~p"/billing/portal"}>
          <button
            type="submit"
            class="rounded-md px-3 py-1.5 text-sm font-medium text-blue-600 transition-colors hover:bg-blue-600/10 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-blue-400"
          >
            Manage subscription
          </button>
        </.form>
      <% end %>
    </div>
    <div class="mt-3 text-sm text-gray-600 dark:text-gray-400">
      Storage used: {@storage_used}<span :if={@storage_cap != "0 B"}> of {@storage_cap}</span>
    </div>
    <%= if @has_subscription do %>
      <.form
        for={%{}}
        as={:cancel}
        action={~p"/billing/cancel"}
        class="mt-3"
        onsubmit="return confirm('Cancel your subscription? Your plan stays active until the end of the current billing period, then your soundboard drops to no plan.')"
      >
        <button
          type="submit"
          class="rounded-md border border-red-500/50 px-3 py-1.5 text-sm font-medium text-red-600 transition-colors hover:bg-red-600/10 focus:outline-none focus:ring-2 focus:ring-red-500 dark:border-red-400/40 dark:text-red-400"
        >
          Cancel subscription
        </button>
      </.form>
    <% end %>
  </div>

  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Pick a plan</h2>

    <div
      class="flex items-center rounded-full bg-gray-200 p-1 text-sm font-medium dark:bg-gray-900"
      id="interval-toggle"
    >
      <button
        type="button"
        data-interval-btn="monthly"
        class="rounded-full px-4 py-1.5 transition-colors"
      >
        Monthly
      </button>
      <button
        type="button"
        data-interval-btn="yearly"
        class="rounded-full px-4 py-1.5 transition-colors"
      >
        Yearly
        <span class="ml-1 text-xs font-semibold text-green-600 dark:text-green-400">
          save 25%
        </span>
      </button>
    </div>
  </div>

  <ul id="plan-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-interval="yearly">
    <%= for tier <- @tiers do %>
      <% tier_name = tier.name |> String.downcase() |> String.to_atom()

      state =
        cond do
          is_nil(@current_tier) -> :new
          tier_name == @current_tier -> :current
          tier.cap_bytes > current_tier_cap(@current_tier) -> :upgrade
          true -> :downgrade
        end %>
      <li class="rounded-lg bg-white p-6 shadow dark:bg-gray-800">
        <div class="flex items-center justify-between gap-2">
          <span class="font-semibold text-gray-800 dark:text-gray-100">{tier.name}</span>
          <span
            :if={state == :current}
            class="rounded-full bg-blue-600/15 px-2.5 py-0.5 text-xs font-semibold text-blue-600 dark:text-blue-400"
          >
            Your plan
          </span>
          <span
            :if={state != :current and @current_tier != nil}
            class="rounded-full bg-gray-200 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-gray-900 dark:text-gray-400"
          >
            {if state == :upgrade, do: "Upgrade", else: "Downgrade"}
          </span>
        </div>
        <div class="mt-0.5 text-xs text-gray-500 dark:text-gray-500">{tier.tagline}</div>

        <div class="mt-4">
          <span
            hidden
            data-price="monthly"
            class="text-3xl font-bold text-gray-800 dark:text-gray-100"
          >
            {Soundboard.Billing.format_price(tier.monthly_amount_cents)}
            <span class="text-sm font-normal text-gray-600 dark:text-gray-400">/month</span>
          </span>
          <span data-price="yearly" class="text-3xl font-bold text-gray-800 dark:text-gray-100">
            {Soundboard.Billing.format_price(tier.yearly_amount_cents)}
            <span class="text-sm font-normal text-gray-600 dark:text-gray-400">/year</span>
          </span>
        </div>

        <ul class="mt-4 space-y-1.5">
          <%= for feature <- tier.features do %>
            <li class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
              <svg
                class="h-3.5 w-3.5 shrink-0 text-green-500"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {feature}
            </li>
          <% end %>
        </ul>

        <div class="mt-5">
          <%= for {interval, price_id} <- [monthly: tier.price_ids.monthly, yearly: tier.price_ids.yearly] do %>
            <%= if state == :current and @current_interval == interval do %>
              <button
                type="button"
                disabled
                data-price={to_string(interval)}
                class="w-full cursor-default rounded-md bg-gray-200 px-3 py-2 text-sm font-medium text-gray-500 dark:bg-gray-900 dark:text-gray-400"
              >
                Current plan
              </button>
            <% else %>
              <.form
                :if={@has_subscription}
                for={%{}}
                as={:checkout}
                action={~p"/billing/change"}
                data-price={to_string(interval)}
                hidden={state == :downgrade and interval == :yearly}
              >
                <input type="hidden" name="price_id" value={price_id} />
                <button
                  type="submit"
                  class="w-full rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-40"
                  disabled={is_nil(price_id)}
                >
                  {form_label(state, interval)}
                </button>
              </.form>
              <.form
                :if={!@has_subscription}
                for={%{}}
                as={:checkout}
                action={~p"/billing/checkout"}
                data-price={to_string(interval)}
                hidden={state == :downgrade and interval == :yearly}
              >
                <input type="hidden" name="price_id" value={price_id} />
                <button
                  type="submit"
                  class="w-full rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-40"
                  disabled={is_nil(price_id)}
                >
                  {cta_label(state)}
                </button>
              </.form>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <p class="mt-6 text-sm">
    <a href={~p"/guilds"} class="font-medium text-blue-600 hover:underline dark:text-blue-400">
      ← Back to soundboards
    </a>
  </p>
</div>

<script>
  (function () {
    var grid = document.getElementById("plan-grid");
    var buttons = document.querySelectorAll("[data-interval-btn]");

    function activate(mode) {
      grid.dataset.interval = mode;
      buttons.forEach(function (btn) {
        var active = btn.dataset.intervalBtn === mode;
        btn.className =
          "rounded-full px-4 py-1.5 transition-colors " +
          (active
            ? "bg-white text-gray-900 shadow dark:bg-gray-700 dark:text-white"
            : "text-gray-600 dark:text-gray-400");
      });
      document.querySelectorAll("[data-price]").forEach(function (el) {
        el.hidden = el.dataset.price !== mode;
      });
    }

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        activate(btn.dataset.intervalBtn);
      });
    });

    activate("yearly");
  })();
</script>
