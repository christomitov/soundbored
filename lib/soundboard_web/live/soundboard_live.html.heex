<%= cond do %>
  <% Soundboard.Theme.retro?(@theme) -> %>
    <% tags = all_tags(@uploaded_files) %>
    <% sounds = filter_sounds(@uploaded_files, @search_query, @selected_tags) %>
    <% limited_tags = if @show_all_tags, do: tags, else: Enum.take(tags, 12) %>

    <section class={["riso-head", @now_playing && "is-playing"]}>
      <div class="riso-eyebrow">
        <span class="riso-lamp"></span>
        <span>
          {if @now_playing, do: "Now playing", else: "#{length(@uploaded_files)} sounds loaded"}
        </span>
      </div>
      <div class="riso-title-wrap">
        <span class="riso-title riso-title-ghost" aria-hidden="true">
          {if @now_playing, do: @now_playing.display_name, else: "SoundBored"}
        </span>
        <h1 class="riso-title">
          {if @now_playing, do: @now_playing.display_name, else: "SoundBored"}
        </h1>
      </div>
      <div class="riso-tagline">
        <span>
          <%= if @now_playing do %>
            {if @now_playing[:live?], do: "Live", else: "Playing"} · by {@now_playing.played_by}
          <% else %>
            Pick a sound and send it to the room
          <% end %>
        </span>
        <div
          id="riso-playback-progress"
          class="riso-meter"
          phx-hook={if @now_playing && !@now_playing[:live?], do: "PlaybackProgress", else: nil}
          data-duration-ms={if @now_playing, do: @now_playing.duration_ms || "", else: ""}
          data-started-at={if @now_playing, do: @now_playing.started_at || "", else: ""}
          aria-label="Playback progress"
        >
          <span
            data-role="progress-bar"
            class={[
              "riso-meter-fill",
              @now_playing && is_nil(@now_playing.duration_ms) && "animate-pulse"
            ]}
            style={if @now_playing && @now_playing.duration_ms, do: "width: 0%", else: nil}
          >
          </span>
        </div>
        <span class="riso-state">{if @now_playing, do: "On air", else: "Standby"}</span>
        <button
          :if={
            @current_user && @now_playing && @now_playing.sound_id &&
              @now_playing.media_type == "sound"
          }
          type="button"
          phx-click="toggle_favorite"
          phx-value-sound-id={@now_playing.sound_id}
          class="riso-now-favorite"
          aria-pressed={to_string(@now_playing.sound_id in @favorites)}
          aria-label={
            if @now_playing.sound_id in @favorites,
              do: "Remove from favorites",
              else: "Add to favorites"
          }
          title={
            if @now_playing.sound_id in @favorites,
              do: "Remove from favorites",
              else: "Add to favorites"
          }
        >
          {if @now_playing.sound_id in @favorites, do: "★", else: "☆"}
        </button>
        <button type="button" phx-click="stop_sound" class="riso-btn riso-btn-pink">
          Stop all
        </button>
      </div>
    </section>

    <section class="riso-tools">
      <form phx-change="search" phx-submit="search" class="riso-find">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
        >
          <circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" />
        </svg>
        <input
          id="retro-search"
          type="search"
          name="query"
          value={@search_query}
          placeholder="Search sounds"
          aria-label="Search sounds"
          autofocus
          phx-debounce="400"
          autocomplete="off"
        />
      </form>
      <a
        :if={@bot_invite_url && !@bot_in_guild?}
        href={@bot_invite_url}
        target="_blank"
        rel="noopener noreferrer"
        class="riso-btn"
      >
        Invite to Server
      </a>
      <button type="button" phx-click="play_random" class="riso-btn">Random</button>
      <button type="button" phx-click="show_upload_modal" class="riso-btn riso-btn-blue">
        + Add sound
      </button>
    </section>

    <section class="riso-categories" aria-label="Sound categories">
      <%= for tag <- limited_tags do %>
        <button
          type="button"
          phx-click="toggle_tag_filter"
          phx-value-tag={tag.name}
          class="riso-category"
          aria-pressed={to_string(tag_selected?(tag, @selected_tags))}
        >
          {tag.name} {SoundboardWeb.Live.Support.LiveTags.count_sounds_with_tag(
            @uploaded_files,
            tag
          )}
        </button>
      <% end %>
      <button
        :if={length(tags) > 12}
        type="button"
        phx-click="toggle_tag_list"
        class="riso-category"
      >
        {if @show_all_tags, do: "Fewer", else: "More"}
      </button>
      <span class="riso-tally">
        {length(sounds)} of {length(@uploaded_files)} sounds
        <span :if={@selected_tags != []}> ·     {hd(@selected_tags).name}</span>
      </span>
    </section>

    <section class="riso-lineup" aria-label="Sounds">
      <%= if @loading_sounds do %>
        <div class="riso-none">
          <div class="loading-spinner"></div>
          <span>Loading the lineup</span>
        </div>
      <% else %>
        <%= if sounds == [] do %>
          <p class="riso-none">Nothing matches that. Clear the search or add it.</p>
        <% else %>
          <%= for {sound, index} <- Enum.with_index(sounds) do %>
            <% playing? =
              @now_playing &&
                (@now_playing.sound_id == sound.id || @now_playing.filename == sound.filename) %>
            <% favorited? = sound.id in @favorites %>
            <article class={["riso-row", playing? && "is-live"]}>
              <button
                type="button"
                phx-click="play"
                phx-value-name={sound.filename}
                class="riso-row-play"
                aria-label={"Play #{display_name(sound.filename)}"}
              >
              </button>
              <span class="riso-rank">
                {String.pad_leading(Integer.to_string(index + 1), 2, "0")}
              </span>
              <span class="riso-row-middle">
                <span class="riso-row-title">{display_name(sound.filename)}</span>
                <span class="riso-row-sub">
                  <button
                    :if={sound.tags != []}
                    type="button"
                    phx-click="toggle_tag_filter"
                    phx-value-tag={hd(sound.tags).name}
                    class="riso-row-tag"
                  >
                    {hd(sound.tags).name}
                  </button>
                  <span :if={sound.user && sound.user.username}>
                    Uploaded by {sound.user.username}
                  </span>
                </span>
              </span>
              <span class="riso-row-actions">
                <span class="riso-hotkey">{pad_key(index)}</span>
                <button
                  id={"retro-local-play-#{sound.id}"}
                  type="button"
                  phx-hook="LocalPlayer"
                  data-filename={sound.storage_key}
                  data-source-type={sound.source_type}
                  data-url={sound.url}
                  data-volume={sound.volume || 1.0}
                  class="riso-action"
                  aria-label={"Play #{display_name(sound.filename)} locally"}
                  title="Play locally"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" class="play-icon">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  <svg viewBox="0 0 24 24" fill="currentColor" class="stop-icon hidden">
                    <path d="M6 6h12v12H6z" />
                  </svg>
                </button>
                <button
                  :if={@current_user}
                  type="button"
                  phx-click="toggle_favorite"
                  phx-value-sound-id={sound.id}
                  class="riso-favorite"
                  aria-pressed={to_string(favorited?)}
                  aria-label={"Favorite #{display_name(sound.filename)}"}
                >
                  {if favorited?, do: "★", else: "☆"}
                </button>
                <button
                  type="button"
                  phx-click="edit"
                  phx-value-id={sound.id}
                  class="riso-action"
                  aria-label={"Edit #{display_name(sound.filename)}"}
                  title="Edit"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 013 3L8 18l-4 1 1-4z" />
                  </svg>
                </button>
              </span>
            </article>
          <% end %>
          <button type="button" phx-click="show_upload_modal" class="riso-add">
            <b>+</b><span>Add a sound to the lineup</span>
          </button>
        <% end %>
      <% end %>
    </section>

    <footer class="riso-footer">
      <span :if={@current_user} class="riso-footer-user">
        <img src={@current_user.avatar} alt="" />
        {@current_user.username}
      </span>
      <span class="riso-footer-spacer"></span>
      <span>Shared soundboard</span>
      <span>Tap a title to play</span>
    </footer>
  <% Soundboard.Theme.desk?(@theme) -> %>
    <section class="controls">
      <form phx-change="search" phx-submit="search" class="slot">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
        >
          <circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" />
        </svg>
        <input
          id="desk-search"
          type="search"
          name="query"
          value={@search_query}
          placeholder="Search sounds"
          aria-label="Search sounds"
          autofocus
          phx-debounce="400"
          autocomplete="off"
        />
      </form>
      <div class="actions">
        <a
          :if={@bot_invite_url && !@bot_in_guild?}
          href={@bot_invite_url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
        >
          Invite to Server
        </a>
        <button type="button" phx-click="play_random" class="btn">Random</button>
        <button type="button" phx-click="show_upload_modal" class="btn primary">
          + Add Sound
        </button>
      </div>
      <% tags = all_tags(@uploaded_files) %>
      <% filtered = filter_sounds(@uploaded_files, @search_query, @selected_tags) %>
      <% limited_tags =
        if @show_all_tags do
          tags
        else
          Enum.take(tags, 12)
        end %>
      <div class="banks">
        <%= for tag <- limited_tags do %>
          <button
            type="button"
            phx-click="toggle_tag_filter"
            phx-value-tag={tag.name}
            class="chip"
            aria-pressed={to_string(tag_selected?(tag, @selected_tags))}
          >
            {tag.name} · {SoundboardWeb.Live.Support.LiveTags.count_sounds_with_tag(
              @uploaded_files,
              tag
            )}
          </button>
        <% end %>
        <%= if length(tags) > 12 do %>
          <button type="button" phx-click="toggle_tag_list" class="chip">
            {if @show_all_tags, do: "Fewer", else: "More"}
          </button>
        <% end %>
        <span class="count">
          {length(filtered)} of {length(@uploaded_files)} sounds
          <%= if @selected_tags != [] do %>
            · {hd(@selected_tags).name}
          <% else %>
            · {length(tags)} banks
          <% end %>
        </span>
      </div>
    </section>

    <section class="pad-grid">
      <%= if @loading_sounds do %>
        <div class="noresult">
          <div class="loading-container">
            <div class="loading-spinner"></div>
          </div>
        </div>
      <% else %>
        <% sounds = filter_sounds(@uploaded_files, @search_query, @selected_tags) %>
        <%= if sounds == [] do %>
          <p class="noresult">No sound matches that. Clear the search or add it.</p>
        <% else %>
          <%= for {sound, index} <- Enum.with_index(sounds) do %>
            <% playing? =
              @now_playing &&
                (@now_playing.sound_id == sound.id || @now_playing.filename == sound.filename) %>
            <% favorited? = sound.id in @favorites %>
            <div class={["pad", playing? && "live"]}>
              <button
                type="button"
                phx-click="play"
                phx-value-name={sound.filename}
                class="absolute inset-0 z-0 cursor-pointer rounded-[5px]"
                aria-label={"Play #{display_name(sound.filename)}"}
              >
              </button>
              <span class="led"></span>
              <span class="padtop">
                <span class="cap">{pad_key(index)}</span>
                <%= if @current_user do %>
                  <button
                    type="button"
                    phx-click="toggle_favorite"
                    phx-value-sound-id={sound.id}
                    class="star"
                    aria-pressed={to_string(favorited?)}
                    aria-label={"Favorite #{display_name(sound.filename)}"}
                  >
                    {if favorited?, do: "★", else: "☆"}
                  </button>
                <% end %>
              </span>
              <.waveform seed={sound.id} />
              <span class="name">{display_name(sound.filename)}</span>
              <span class="padfoot">
                <%= if sound.tags != [] do %>
                  <% tag = hd(sound.tags) %>
                  <button
                    type="button"
                    phx-click="toggle_tag_filter"
                    phx-value-tag={tag.name}
                    class="tag"
                  >
                    {tag.name}
                  </button>
                <% end %>
                <span class="meta">
                  <%= if sound.user && sound.user.username do %>
                    {sound.user.username}
                  <% end %>
                </span>
              </span>
              <div class="pad-actions">
                <button
                  id={"local-play-#{Path.basename(sound.filename, Path.extname(sound.filename))}"}
                  type="button"
                  phx-hook="LocalPlayer"
                  data-filename={sound.storage_key}
                  data-source-type={sound.source_type}
                  data-url={sound.url}
                  data-volume={sound.volume || 1.0}
                  title="Play locally"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-3.5 h-3.5 play-icon"
                  >
                    <path d="M12 15a3 3 0 100-6 3 3 0 000 6z" />
                    <path
                      fill-rule="evenodd"
                      d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 010-1.113zM17.25 12a5.25 5.25 0 11-10.5 0 5.25 5.25 0 0110.5 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-3.5 h-3.5 stop-icon hidden"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M4.5 7.5a3 3 0 013-3h9a3 3 0 013 3v9a3 3 0 01-3 3h-9a3 3 0 01-3-3v-9z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </button>
                <button type="button" phx-click="edit" phx-value-id={sound.id} title="Edit">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-3.5 h-3.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"
                    />
                  </svg>
                </button>
              </div>
            </div>
          <% end %>
          <button type="button" phx-click="show_upload_modal" class="empty-pad">
            <b>+</b>Add sound
          </button>
        <% end %>
      <% end %>
    </section>
  <% true -> %>
    <div class="max-w-6xl mx-auto px-4 py-8">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-8">
        <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100 flex-1 min-w-[200px]">
          <span class="group relative cursor-default inline-block">
            Sounds<div class="pointer-events-none fixed inset-0 opacity-0 group-hover:opacity-100 transition-all duration-300 z-[9999]">
            <img
                src="/images/kubernetes.gif"
                alt="kubernetes"
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] object-contain"
              />
          </div>
          </span>
        </h1>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center sm:justify-end gap-2 w-full sm:w-auto">
          <a
            :if={@bot_invite_url && !@bot_in_guild?}
            href={@bot_invite_url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex justify-center px-3 py-2 sm:px-4 sm:py-2 bg-emerald-600 text-white font-medium rounded-md
                 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 transition-colors
                 dark:focus:ring-offset-gray-900 text-sm sm:text-base"
          >
            Invite to Server
          </a>
          <button
            phx-click="show_upload_modal"
            class="w-full sm:w-auto justify-center px-3 py-2 sm:px-4 sm:py-2 bg-blue-600 text-white font-medium rounded-md
                 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors
                 dark:focus:ring-offset-gray-900 text-sm sm:text-base"
          >
            Add Sound
          </button>
          <button
            phx-click="play_random"
            class="w-full sm:w-auto justify-center px-3 py-2 sm:px-4 sm:py-2 rounded-md text-sm sm:text-base font-medium transition-colors
                 border border-blue-500/60 text-blue-600 dark:text-blue-300 hover:bg-blue-500/10 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Play Random
          </button>
          <button
            phx-click="stop_sound"
            class="w-full sm:w-auto justify-center px-3 py-2 sm:px-4 sm:py-2 rounded-md text-sm sm:text-base font-medium transition-colors
                 border border-red-500/70 text-red-600 dark:text-red-300 hover:bg-red-500/10 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Stop All
          </button>
        </div>
      </div>

      <div class="mb-8">
        <form phx-change="search" phx-submit="search" class="relative">
          <input
            type="text"
            name="query"
            value={@search_query}
            placeholder="Search sounds..."
            autofocus
            phx-debounce="400"
            class="block w-full rounded-md border-gray-300 dark:border-gray-700 shadow-sm pl-4 pr-10 py-2
                 focus:border-blue-500 focus:ring-blue-500 sm:text-sm
                 dark:bg-gray-800 dark:text-gray-100 dark:placeholder-gray-400"
            autocomplete="off"
          />
          <div class="absolute inset-y-0 right-0 flex items-center pr-3">
            <svg
              class="search-icon h-5 w-5 text-gray-400 dark:text-gray-500"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                clip-rule="evenodd"
              />
            </svg>
            <svg
              class="search-spinner hidden animate-spin h-5 w-5 text-gray-400 dark:text-gray-500"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              >
              </circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
              >
              </path>
            </svg>
          </div>
        </form>
      </div>

      <% tags = all_tags(@uploaded_files) %>
      <% limited_tags =
        if @show_all_tags do
          tags
        else
          Enum.take(tags, 12)
        end %>
      <div class="mb-4 flex flex-wrap gap-2 items-center sm:hidden">
        <%= for tag <- limited_tags do %>
          <.tag_filter_button
            tag={tag}
            selected_tags={@selected_tags}
            uploaded_files={@uploaded_files}
          />
        <% end %>
        <%= if length(tags) > 12 do %>
          <button
            phx-click="toggle_tag_list"
            class="inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-medium
                 bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            {if @show_all_tags, do: "Show fewer tags", else: "Show more tags"}
          </button>
        <% end %>
      </div>
      <div class="mb-4 hidden sm:flex sm:flex-wrap sm:gap-2 sm:items-center">
        <%= for tag <- tags do %>
          <.tag_filter_button
            tag={tag}
            selected_tags={@selected_tags}
            uploaded_files={@uploaded_files}
          />
        <% end %>
      </div>

      <div class="flex justify-between items-center mb-2">
        <div class="text-sm text-gray-600 dark:text-gray-400">
          <p style="font-weight: bold">Total Sounds: {length(@uploaded_files)}</p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <%= if @loading_sounds do %>
          <div class="col-span-full">
            <div class="loading-container">
              <div class="loading-spinner"></div>
            </div>
          </div>
        <% else %>
          <%= for sound <- filter_sounds(@uploaded_files, @search_query, @selected_tags) do %>
            <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-md transition-all duration-200">
              <button
                phx-click="play"
                phx-value-name={sound.filename}
                class="absolute inset-0 w-full h-full cursor-pointer z-0
                     hover:bg-green-50 dark:hover:bg-green-900/20 rounded-lg
                     focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2
                     dark:focus:ring-offset-gray-800"
              >
              </button>

              <div class="relative z-10 p-4 flex flex-col min-h-[120px] pointer-events-none">
                <div class="flex-1 min-w-0">
                  <div class="text-gray-800 dark:text-gray-200 font-medium break-all">
                    {display_name(sound.filename)}
                  </div>
                  <%= if sound.user && sound.user.username do %>
                    <div class="text-xs text-gray-500 dark:text-gray-400">
                      Uploaded by {sound.user.username}
                    </div>
                  <% end %>
                </div>

                <div class="mt-auto pt-2 flex justify-between items-center">
                  <div class="flex flex-wrap gap-1 items-center pointer-events-auto z-20">
                    <%= if sound.tags != [] do %>
                      <%= for tag <- sound.tags do %>
                        <button
                          phx-click="toggle_tag_filter"
                          phx-value-tag={tag.name}
                          class={[
                            "inline-flex items-center rounded-full px-2 py-1 text-xs font-medium transition-colors",
                            if(tag_selected?(tag, @selected_tags),
                              do: "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300",
                              else:
                                "bg-blue-50 text-blue-600 hover:bg-blue-100 dark:bg-blue-900/50 dark:text-blue-300 dark:hover:bg-blue-900"
                            )
                          ]}
                        >
                          {tag.name}
                        </button>
                      <% end %>
                    <% end %>
                  </div>

                  <div class="flex items-center gap-2 ml-2 flex-shrink-0 pointer-events-auto">
                    <button
                      id={"local-play-#{Path.basename(sound.filename, Path.extname(sound.filename))}"}
                      phx-hook="LocalPlayer"
                      data-filename={sound.storage_key}
                      data-source-type={sound.source_type}
                      data-url={sound.url}
                      data-volume={sound.volume || 1.0}
                      class="relative flex items-center justify-center w-8 h-8 text-gray-400 hover:text-green-600
                           dark:text-gray-500 dark:hover:text-green-400 rounded-md transition-colors"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-4 h-4 play-icon"
                      >
                        <path d="M12 15a3 3 0 100-6 3 3 0 000 6z" />
                        <path
                          fill-rule="evenodd"
                          d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 010-1.113zM17.25 12a5.25 5.25 0 11-10.5 0 5.25 5.25 0 0110.5 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-4 h-4 stop-icon hidden"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M4.5 7.5a3 3 0 013-3h9a3 3 0 013 3v9a3 3 0 01-3 3h-9a3 3 0 01-3-3v-9z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </button>
                    <%= if @current_user do %>
                      <button
                        phx-click="toggle_favorite"
                        phx-value-sound-id={sound.id}
                        class="relative flex items-center justify-center w-8 h-8 text-gray-400 hover:text-red-500
                             dark:text-gray-500 dark:hover:text-red-500 rounded-md transition-colors"
                      >
                        <%= if sound.id in @favorites do %>
                          <.icon name="hero-heart-solid" class="w-4 h-4 text-red-500" />
                        <% else %>
                          <.icon name="hero-heart" class="w-4 h-4" />
                        <% end %>
                      </button>
                    <% end %>
                    <button
                      phx-click="edit"
                      phx-value-id={sound.id}
                      class="relative flex items-center justify-center w-8 h-8 text-gray-400 hover:text-blue-600
                           dark:text-gray-500 dark:hover:text-blue-400 rounded-md"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-4 h-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"
                        />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
<% end %>

<%= if @show_modal do %>
  <.edit_modal
    flash={@flash}
    edit_name_error={@edit_name_error}
    current_user={@current_user}
    current_sound={@current_sound}
    tag_input={@tag_input}
    tag_suggestions={@tag_suggestions}
  />
  <%= if @show_delete_confirm do %>
    <.delete_modal {assigns} />
  <% end %>
<% end %>

<%= if @show_upload_modal do %>
  <.upload_modal {assigns} />
<% end %>

<script>
  window.addEventListener("phx:clear-tag-input", (e) => {
    document.getElementById("tag-input").value = "";
  })

  window.addEventListener("phx:stop-all-sounds", (e) => {
    document.querySelectorAll('audio').forEach(audio => {
      audio.pause();
      audio.currentTime = 0;
    });

    document.querySelectorAll('.play-icon').forEach(icon => {
      icon.classList.remove('hidden');
    });
    document.querySelectorAll('.stop-icon').forEach(icon => {
      icon.classList.add('hidden');
    });
  });
</script>
